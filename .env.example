# ==============================================================================
# SPORTCONNECT - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (PÚBLICAS - Visibles en el navegador mediante el prefijo VITE_)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL: URL de tu proyecto en Supabase (ej. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# VITE_SUPABASE_ANON_KEY: Clave pública (anon/public). Es segura para el cliente
# y sus permisos están estrictamente limitados por las políticas Row Level Security (RLS).
VITE_SUPABASE_ANON_KEY="tu-anon-key-publica-aqui"

# VITE_API_URL: URL base del backend Express (en local generalmente http://localhost:3000 o relativo /api)
VITE_API_URL=""

# ------------------------------------------------------------------------------
# 2. BACKEND (PRIVADAS / SECRETAS - NUNCA exponer al cliente ni en el navegador)
# ------------------------------------------------------------------------------
# SUPABASE_URL: URL del proyecto Supabase para inicializar el cliente en Node.js
SUPABASE_URL="https://tu-proyecto.supabase.co"

# SUPABASE_ANON_KEY: Clave anónima para operaciones delegadas en el servidor
SUPABASE_ANON_KEY="tu-anon-key-publica-aqui"

# SUPABASE_SERVICE_ROLE_KEY: ¡CRÍTICA Y PRIVADA! Esta clave bypasses RLS (administrador).
# SOLO debe existir en el entorno del backend y NUNCA enviarse al navegador o frontend.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-privada-y-secreta"

# PORT: Puerto en el que se ejecuta el servidor Express (por defecto 3000)
PORT=3000

# APP_URL: URL de hosting en Cloud Run o preview
APP_URL="http://localhost:3000"
